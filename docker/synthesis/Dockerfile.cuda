# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

FROM ghcr.io/astral-sh/uv:0.11.8@sha256:3b7b60a81d3c57ef471703e5c83fd4aaa33abcd403596fb22ab07db85ae91347 AS uv

FROM pytorch/pytorch:2.13.0-cuda13.0-cudnn9-runtime@sha256:db80a41f8428644cebcb3d75b0b62df334ab6c0e75785951eb25f48bfbd42407

COPY --from=uv /uv /uvx /usr/local/bin/

ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_NO_PROGRESS=1 \
    PATH="/opt/synthesis-cuda-venv/bin:${PATH}" \
    PYTHONPATH="/opt/document-ocr/src" \
    PYTORCH_ALLOC_CONF="expandable_segments:True"

WORKDIR /opt/document-ocr

COPY environments/synthesis/pyproject.toml environments/synthesis/uv.lock ./environments/synthesis/

# The immutable base supplies CUDA-matched Torch. All other packages are
# installed from the synthesis lock with hashes; pruning Torch prevents uv from
# replacing the CUDA build with the CPU-only wheel pinned for the CPU service.
# The base image's unrelated Spin developer CLI conflicts with locked Click.
RUN uv pip uninstall --system --break-system-packages spin \
    && uv venv --system-site-packages --python /usr/bin/python /opt/synthesis-cuda-venv \
    && uv export --quiet --project environments/synthesis --frozen --no-dev \
      --prune torch --format requirements.txt --output-file /tmp/synthesis-requirements.txt \
    && uv pip install --python /opt/synthesis-cuda-venv/bin/python --no-deps --require-hashes \
      --requirements /tmp/synthesis-requirements.txt \
    && python -m pip check

COPY src ./src
COPY docker/synthesis/Dockerfile.cuda ./docker/synthesis/Dockerfile.cuda
COPY docker/synthesis/verify_cuda_environment.py ./docker/synthesis/verify_cuda_environment.py

RUN python docker/synthesis/verify_cuda_environment.py

ENTRYPOINT ["python", "-m", "document_ocr.synthesis.cli"]
CMD ["--help"]
