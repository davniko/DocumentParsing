# Change before starting the server. Never commit a real key.
VLLM_API_KEY=replace-with-a-long-random-value

# A non-default host port also requires the vllm.endpoint port in the extraction
# YAML to match. Scheduler/model settings are immutable in compose.yaml.
VLLM_PORT=8000

# Accept the Gemma license for this Hugging Face account before training. Keep
# the token local; the training runtime redacts it and never writes it to artifacts.
HF_TOKEN=replace-with-a-hugging-face-read-token

# Used only by the PydanticAI labeling workflow. Keep the real key in .env;
# immutable run artifacts store provider/model identities and usage, never keys.
OPENAI_API_KEY=replace-with-an-openai-api-key
